# ---------------------------------------------------------------------------
# ZoneVision configuration. Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development          # development | production | test
LOG_LEVEL=INFO
LOG_JSON=false                   # true = one JSON object per log line

# --- Database (PostgreSQL is primary) ----------------------------------------
POSTGRES_USER=zonevision
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=zonevision
POSTGRES_PORT=5432
# Used by a locally running backend (outside Docker). Docker Compose builds its
# own URL pointing at the `db` service.
DATABASE_URL=postgresql+psycopg://zonevision:change-me-locally@localhost:5432/zonevision
# Fallback without PostgreSQL (development only):
# DATABASE_URL=sqlite:///./storage/zonevision.db

# --- HTTP --------------------------------------------------------------------
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- Storage -----------------------------------------------------------------
# Relative paths are resolved from the project root.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=500

# --- Model -------------------------------------------------------------------
MODEL_WEIGHTS=yolo11n.pt         # official Ultralytics name or a path to .pt weights
# MODEL_DIR=./storage/models     # defaults to <STORAGE_DIR>/models
MODEL_AUTO_DOWNLOAD=true         # download official weights on first use
INFERENCE_DEVICE=auto            # auto | cpu | cuda:0 | mps

# Defaults for the editable processing settings (Settings page overrides these)
DEFAULT_CONFIDENCE=0.35
DEFAULT_IMAGE_SIZE=640
DEFAULT_TARGET_FPS=6

# --- Background worker -------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=1.0

# --- Frontend (Vite) ---------------------------------------------------------
# Base URL of the API as seen by the *browser*. Empty = same origin (the
# frontend container / Vite dev server proxies /api to the backend).
VITE_API_BASE_URL=
